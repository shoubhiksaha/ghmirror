# Sample .env as written by `ghmirror init` (mode 0600, next to docker-compose.yml). Never commit the real one.
# GitHub, one of:
GITHUB_TOKEN=ghp_REPLACE_ME                    # token mode
# GITHUB_APP_ID=123456                         # GitHub App mode (key in secrets/github-app.pem)
# GITHUB_APP_INSTALLATION_ID=78901234
GITHUB_MIGRATION_TOKEN=                        # optional classic PAT (repo, admin:org) for GitHub migration archives
GITHUB_WEBHOOK_SECRET=REPLACE_WITH_64_HEX      # init generates it: python3 -c 'import secrets;print(secrets.token_hex(32))'
GHM_WEBHOOK_URL=https://mirror.acme.example/webhook
# one per target, name upper-cased: target "cloud" -> GITLAB_CLOUD_TOKEN (printed by prepare-host.sh)
GITLAB_CLOUD_TOKEN=glpat-REPLACE_ME
GITLAB_OFFLINE_TOKEN=glpat-REPLACE_ME
POSTGRES_PASSWORD=REPLACE_WITH_RANDOM_32       # internal to the Compose network
ALERT_WEBHOOK_URL=                             # Slack-compatible incoming webhook (optional, recommended)
